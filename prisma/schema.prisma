generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id               String   @id @default(cuid())
  placeId          String?  @unique
  name             String
  address          String?
  phone            String?
  email            String?
  website          String?
  category         String?
  searchedCategory String?
  city             String?
  googleMapsUrl    String?
  reports          Report[]
  agentResearches  AgentResearch[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([city])
  @@index([category])
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}

model Report {
  id         String       @id @default(cuid())
  businessId String
  status     ReportStatus @default(PENDING)

  reportData Json?
  pdfUrl     String?
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}


// research model schema


enum ResearchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model AgentResearch {
  id         String         @id @default(cuid())
  businessId String
  status     ResearchStatus @default(PENDING)

  websiteExists Boolean?
  researchData  Json?
  error         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}
